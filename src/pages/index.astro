---
import BaseLayout from '../layouts/BaseLayout.astro';

const featuredProducts = [
  {
    name: '100% Arabica AAA',
    notes: 'Bright berries, citrus blossom, dark chocolate finish.',
    bestFor: 'Pour Over / Chemex',
    href: '/products/',
  },
  {
    name: '100% Robusta AAA (Kaapi Royale)',
    notes: 'Dense crema, toasted walnut, and spiced dark cacao notes.',
    bestFor: 'Espresso / South Indian Filter',
    href: '/products/',
  },
  {
    name: 'Monsoon Malabar AA',
    notes: 'Velvety, near-zero acidity, salted caramel, aged oak.',
    bestFor: 'Moka Pot / Low-Acid Brews',
    href: '/products/',
  },
];
---

<BaseLayout title="Home" description="Estate & Ember Coffee Roasters - Where Precision Meets Passion.">
  <section class="space-y-16">
    <!-- Hero Section -->
    <div class="rounded-3xl border border-slate-800 bg-slate-900/80 p-8 text-center">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Indian Specialty & Commercial Grade Roasters</h2>
      <p class="mt-4 max-w-2xl mx-auto text-lg text-slate-300">
        100% shade-grown Arabica and Robusta single estate beans sourced from the high altitudes of India.
      </p>
      <div class="mt-8 flex justify-center gap-4">
        <a
          href="/products/"
          class="inline-flex items-center justify-center rounded-full bg-amber-400 px-8 py-3 text-base font-semibold text-slate-950 transition hover:bg-amber-300"
        >
          Explore Our Coffees
        </a>
        <a
          href="/about/"
          class="inline-flex items-center justify-center rounded-full border border-slate-700 px-8 py-3 text-base font-semibold text-slate-100 transition hover:border-slate-500"
        >
          Our Story
        </a>
      </div>
    </div>

    <!-- Featured Products Section -->
    <div>
      <h3 class="text-3xl font-bold text-center">Featured Coffees</h3>
      <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-8">
        {
          featuredProducts.map((product) => (
            <a href={product.href} class="block rounded-3xl border border-slate-800 bg-slate-900/80 p-8 transition-transform duration-300 hover:scale-105 hover:border-amber-400/50">
              <article class="flex flex-col h-full">
                <h4 class="text-2xl font-semibold text-amber-300">{product.name}</h4>
                <p class="mt-4 flex-grow text-slate-300">{product.notes}</p>
                <div class="mt-6 pt-4 border-t border-slate-800">
                  <span class="inline-block rounded-full bg-slate-800 px-4 py-1 text-xs font-semibold text-amber-400">
                    Best for: {product.bestFor}
                  </span>
                </div>
              </article>
            </a>
          ))
        }
      </div>
    </div>

    <!-- Heritage Section -->
    <div class="grid md:grid-cols-2 gap-10 items-center rounded-3xl border border-slate-800 bg-slate-900/80 p-8">
      <div>
        <h3 class="text-3xl font-bold">Our Heritage</h3>
        <p class="mt-5 leading-8 text-slate-300">
          Coffee in India began in 1670 when Sufi saint <span class="font-semibold text-amber-300">Baba Budan</span> brought seven raw coffee beans from Mocha, Yemen, and planted them in the hills of Chikmagalur.
        </p>
        <p class="mt-4 leading-8 text-slate-300">
          Grown under a forest canopy alongside aromatic spices, our beans naturally develop a heavy body, low acidity, and rich sweetness.
        </p>
      </div>
      <div class="text-center">
        <p class="text-lg text-slate-200 mb-6">Discover the legacy behind every cup.</p>
        <a
          href="/about/"
          class="inline-flex items-center justify-center rounded-full bg-amber-400 px-10 py-4 text-lg font-semibold text-slate-950 transition hover:bg-amber-300"
        >
          Learn More About Us
        </a>
      </div>
    </div>
  </section>
</BaseLayout>