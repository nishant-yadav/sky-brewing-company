---
import BaseLayout from '../layouts/BaseLayout.astro';

const brewMethods = [
  {
    title: '1. Pour Over (V60 / Chemex)',
    details: 'Ratio 1:15 • Medium-Coarse Grind',
    steps: [
      'Pre-wet filter, add 15g coffee, bloom with 45g water for 30s.',
      'Finish slow concentric pour to 225ml in 2:30-3:00 min.'
    ]
  },
  {
    title: '2. Iced Americano',
    details: 'Double Shot (40ml) + 150ml Chilled Water + Ice',
    steps: [
      'Fill tall glass with ice cubes, pour chilled filtered water.',
      'Gently layer fresh double espresso on top.'
    ]
  },
  {
    title: '3. Creamy Cold Coffee',
    details: '50ml Espresso + 150ml Milk + Ice & Sugar',
    steps: [
      'Blend chilled milk, espresso base, and ice on high speed for 40 seconds until thick and frothy.',
      'Dust with cocoa.'
    ]
  },
  {
    title: '4. Moka Pot Espresso',
    details: 'Medium-Fine Grind • Stovetop',
    steps: [
      'Fill lower boiler to safety valve with pre-heated water.',
      'Fill basket level without tamping, brew on medium-low flame.'
    ]
  }
];
---

<BaseLayout title="Home Brewing Masterclass" description="Learn how to brew the perfect cup of coffee at home with our expert guides.">
  <section class="space-y-12">
    <div class="rounded-3xl border border-slate-800 bg-slate-900/80 p-8 text-center">
      <h2 class="text-4xl font-bold">Home Brewing Masterclass</h2>
      <p class="mt-4 max-w-2xl mx-auto text-slate-300">Simple recipes to help you craft the perfect cup at home.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {brewMethods.map(method => (
        <article class="rounded-3xl border border-slate-800 bg-slate-900/80 p-8">
          <h3 class="text-2xl font-semibold text-amber-300">{method.title}</h3>
          <p class="mt-2 text-sm text-slate-400">{method.details}</p>
          <ul class="mt-4 space-y-2 list-disc list-inside text-slate-300">
            {method.steps.map(step => <li>{step}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>