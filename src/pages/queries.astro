---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Customer Queries | Estate & Ember" description="Submit your coffee inquiry or question to Estate & Ember Coffee Roasters">
  <section class="space-y-10">
    <div class="rounded-3xl border border-slate-800 bg-slate-900/80 p-8">
      <h2 class="text-4xl font-bold">Send us your query</h2>
      <p class="mt-5 max-w-3xl leading-8 text-slate-300">Have questions about our beans, roasts, or services? We'd love to hear from you. Fill out the form below and we'll get back to you shortly.</p>
    </div>

    <div class="rounded-3xl border border-slate-800 bg-slate-900/80 p-8">
      <form id="queryForm" class="space-y-6">
        <!-- Name Field -->
        <div>
          <label for="name" class="block text-sm font-medium text-slate-100">Full Name *</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            class="mt-2 w-full rounded-lg border border-slate-700 bg-slate-800 px-4 py-3 text-slate-100 placeholder-slate-500 focus:border-amber-400 focus:outline-none focus:ring-2 focus:ring-amber-400/20"
            placeholder="John Doe"
          />
        </div>

        <!-- Email Field -->
        <div>
          <label for="email" class="block text-sm font-medium text-slate-100">Email Address *</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="mt-2 w-full rounded-lg border border-slate-700 bg-slate-800 px-4 py-3 text-slate-100 placeholder-slate-500 focus:border-amber-400 focus:outline-none focus:ring-2 focus:ring-amber-400/20"
            placeholder="john@example.com"
          />
        </div>

        <!-- Phone Field -->
        <div>
          <label for="phone" class="block text-sm font-medium text-slate-100">Phone Number</label>
          <input
            type="tel"
            id="phone"
            name="phone"
            class="mt-2 w-full rounded-lg border border-slate-700 bg-slate-800 px-4 py-3 text-slate-100 placeholder-slate-500 focus:border-amber-400 focus:outline-none focus:ring-2 focus:ring-amber-400/20"
            placeholder="+1 (555) 123-4567"
          />
        </div>

        <!-- Subject Field -->
        <div>
          <label for="subject" class="block text-sm font-medium text-slate-100">Subject *</label>
          <select
            id="subject"
            name="subject"
            required
            class="mt-2 w-full rounded-lg border border-slate-700 bg-slate-800 px-4 py-3 text-slate-100 focus:border-amber-400 focus:outline-none focus:ring-2 focus:ring-amber-400/20"
          >
            <option value="">Select a subject</option>
            <option value="Product Inquiry">Product Inquiry</option>
            <option value="Wholesale Inquiry">Wholesale Inquiry</option>
            <option value="Subscription">Subscription</option>
            <option value="Technical Support">Technical Support</option>
            <option value="General Question">General Question</option>
            <option value="Other">Other</option>
          </select>
        </div>

        <!-- Message Field -->
        <div>
          <label for="message" class="block text-sm font-medium text-slate-100">Message *</label>
          <textarea
            id="message"
            name="message"
            required
            rows="6"
            class="mt-2 w-full rounded-lg border border-slate-700 bg-slate-800 px-4 py-3 text-slate-100 placeholder-slate-500 focus:border-amber-400 focus:outline-none focus:ring-2 focus:ring-amber-400/20"
            placeholder="Tell us more about your query..."
          ></textarea>
        </div>

        <!-- Company Field (Optional) -->
        <div>
          <label for="company" class="block text-sm font-medium text-slate-100">Company (Optional)</label>
          <input
            type="text"
            id="company"
            name="company"
            class="mt-2 w-full rounded-lg border border-slate-700 bg-slate-800 px-4 py-3 text-slate-100 placeholder-slate-500 focus:border-amber-400 focus:outline-none focus:ring-2 focus:ring-amber-400/20"
            placeholder="Your company name"
          />
        </div>

        <!-- Checkbox -->
        <div class="flex items-start">
          <input
            type="checkbox"
            id="consent"
            name="consent"
            required
            class="mt-1 rounded border-slate-700 bg-slate-800 text-amber-400 focus:ring-2 focus:ring-amber-400/20"
          />
          <label for="consent" class="ml-3 text-sm text-slate-300">
            I agree to be contacted about my inquiry and receive updates from Estate & Ember Coffee Roasters *
          </label>
        </div>

        <!-- Submit Button -->
        <div class="flex flex-col gap-3 sm:flex-row">
          <button
            type="submit"
            class="inline-flex items-center justify-center rounded-full bg-amber-400 px-8 py-3 text-sm font-semibold text-slate-950 transition hover:bg-amber-300 disabled:opacity-50 disabled:cursor-not-allowed"
            id="submitBtn"
          >
            Send Query
          </button>
          <button
            type="reset"
            class="inline-flex items-center justify-center rounded-full border border-slate-700 px-8 py-3 text-sm font-semibold text-slate-100 transition hover:border-slate-500"
          >
            Clear Form
          </button>
        </div>

        <!-- Status Messages -->
        <div id="successMessage" class="hidden rounded-lg bg-green-900/30 border border-green-700 p-4 text-green-400">
          ✓ Your query has been submitted successfully! We'll get back to you soon.
        </div>
        <div id="errorMessage" class="hidden rounded-lg bg-red-900/30 border border-red-700 p-4 text-red-400">
          ✗ An error occurred while submitting your query. Please try again.
        </div>
      </form>
    </div>

    <div class="grid gap-6 sm:grid-cols-2">
      <div class="rounded-3xl border border-slate-800 bg-slate-900/80 p-8">
        <h3 class="text-2xl font-semibold">Response Time</h3>
        <p class="mt-4 text-slate-300">We typically respond to inquiries within 24-48 hours during business days.</p>
      </div>
      <div class="rounded-3xl border border-slate-800 bg-slate-900/80 p-8">
        <h3 class="text-2xl font-semibold">Direct Contact</h3>
        <p class="mt-4 text-slate-300">For urgent matters, call us at <a href="tel:+917903256957" class="underline hover:text-amber-400">+91 7903256957</a> or email <a href="mailto:estate&ember@gmail.com" class="underline hover:text-amber-400">estate&ember@gmail.com</a></p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('queryForm') as HTMLFormElement;
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
  const successMessage = document.getElementById('successMessage') as HTMLDivElement;
  const errorMessage = document.getElementById('errorMessage') as HTMLDivElement;

  form.addEventListener('submit', async (e: Event) => {
    e.preventDefault();

    // Hide previous messages
    successMessage.classList.add('hidden');
    errorMessage.classList.add('hidden');

    // Disable submit button
    submitBtn.disabled = true;
    submitBtn.textContent = 'Submitting...';

    try {
      const formData = new FormData(form);
      const data = Object.fromEntries(formData);

      const response = await fetch(`${import.meta.env.BASE_URL}api/submit-query`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(data),
      });

      if (response.ok) {
        successMessage.classList.remove('hidden');
        form.reset();
        submitBtn.textContent = 'Send Query';
        submitBtn.disabled = false;
      } else {
        throw new Error('Submission failed');
      }
    } catch (error) {
      console.error('Form submission error:', error);
      errorMessage.classList.remove('hidden');
      submitBtn.textContent = 'Send Query';
      submitBtn.disabled = false;
    }
  });
</script>
