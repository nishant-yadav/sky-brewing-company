---
import BaseLayout from '../layouts/BaseLayout.astro';

const products = [
  {
    name: '100% Arabica AAA',
    altitude: '1,200 – 1,600 MASL',
    notes: 'Specialty Reserve. Bright berries, citrus blossom, dark chocolate finish.',
    bestFor: 'Pour Over / Chemex',
  },
  {
    name: '100% Arabica AA',
    altitude: '1,000 – 1,400 MASL',
    notes: 'Premium Grade. Notes of roasted hazelnut, milk chocolate, and sweet caramel.',
    bestFor: 'Drip / French Press',
  },
  {
    name: '100% Robusta AAA (Kaapi Royale)',
    altitude: '700 - 1,000 MASL',
    notes: 'Kaapi Royale. Dense crema, toasted walnut, and spiced dark cacao notes.',
    bestFor: 'Espresso / South Indian Filter',
  },
  {
    name: '100% Robusta AA',
    altitude: '500 - 800 MASL',
    notes: 'Bold intensity, rich malt, smoked cedar, and thick body.',
    bestFor: 'Moka Pot',
  },
  {
    name: 'Commercial Blends (80/20 & 70/30 AA)',
    altitude: '700 - 1,400 MASL',
    notes: 'Balanced aromatic crema or robust punch engineered for milk lattes.',
    bestFor: 'Espresso & Cappuccino',
  },
  {
    name: 'Monsoon Malabar AA',
    altitude: '900-1,200 MASL (Cured at Sea Level)',
    notes: 'Monsooned process. Velvety, near-zero acidity, salted caramel, aged oak.',
    bestFor: 'Moka Pot / Low-Acid Brews',
  },
];
---

<BaseLayout title="Our Coffees" description="Explore our selection of Indian specialty and commercial grade shade-grown Arabica and Robusta beans.">
  <section class="space-y-12">
    <div class="rounded-3xl border border-slate-800 bg-slate-900/80 p-8 text-center">
      <h2 class="text-4xl font-bold">Products We Offer</h2>
      <p class="mt-4 max-w-2xl mx-auto text-slate-300">100% shade-grown Arabica and Robusta single estate beans sourced from the high altitudes of India.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        products.map((product) => (
          <article class="flex flex-col rounded-3xl border border-slate-800 bg-slate-900/80 p-8 transition-transform duration-300 hover:scale-105 hover:border-amber-400/50">
            <h3 class="text-2xl font-semibold text-amber-300">{product.name}</h3>
            <p class="mt-2 text-sm text-slate-400">
              <strong>Altitude:</strong> {product.altitude}
            </p>
            <p class="mt-4 flex-grow text-slate-300">{product.notes}</p>
            <div class="mt-6 pt-4 border-t border-slate-800">
              <span class="inline-block rounded-full bg-slate-800 px-4 py-1 text-xs font-semibold text-amber-400">
                Best for: {product.bestFor}
              </span>
            </div>
          </article>
        ))
      }
    </div>

    <div class="rounded-3xl border border-slate-800 bg-slate-900/80 p-8 md:p-12">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-4xl font-bold">Subscription & Rewards</h2>
          <p class="mt-5 leading-8 text-slate-300">
            Experience the ultimate convenience with our customizable coffee subscription, delivering freshly roasted beans to your doorstep.
          </p>
          <p class="mt-4 leading-8 text-slate-300">
            As a loyal member, our rewards program grants you exclusive discounts, freebies, and early access to new blends.
          </p>
        </div>
        <div class="text-center">
          <p class="text-lg text-slate-200 mb-6">Ready to elevate your coffee ritual?</p>
          <a
            href="/queries/"
            class="inline-flex items-center justify-center rounded-full bg-amber-400 px-10 py-4 text-lg font-semibold text-slate-950 transition hover:bg-amber-300"
          >
            Inquire About Subscriptions
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>