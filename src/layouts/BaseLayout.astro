---
import "../styles/global.css";
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title ? `${title} · Coffee Roastery` : 'Coffee Roastery'}</title>
    <meta name="description" content={description ?? 'Modern static website for a coffee roastery'} />
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100">
    <div class="mx-auto max-w-6xl px-6 py-8">
      <header class="mb-14">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="text-sm uppercase tracking-[0.32em] text-amber-300">Roastery</p>
            <h1 class="mt-3 text-4xl font-extrabold tracking-tight sm:text-5xl">Crafted coffee for every story.</h1>
          </div>
          <nav class="flex flex-wrap gap-4 text-sm text-slate-300">
            <a href={base} class="hover:text-white">Home</a>
            <a href={`${base}about/`} class="hover:text-white">About</a>
            <a href={`${base}contact/`} class="hover:text-white">Contact</a>
            <a href={`${base}queries/`} class="hover:text-white">Queries</a>
          </nav>
        </div>
      </header>

      <main><slot /></main>

      <footer class="mt-20 border-t border-slate-800 pt-8 text-sm text-slate-500">
        <p>© 2026 Coffee Roastery. Fresh beans, small-batch roasts, delivered with care.</p>
      </footer>
    </div>
  </body>
</html>
